# Configuration marche241-api
# Copiez ce fichier vers .env et remplissez avec vos vraies valeurs

# Configuration de la base de données (Neon)
# Utiliser la chaîne "Pooled connection" (l'hôte doit contenir "-pooler")
DATABASE_URL=postgresql://<user>:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# Taille maximale du pool de connexions Postgres (optionnel, defaut: 10)
DATABASE_POOL_MAX=10

# Configuration JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# IDs vendeurs autorisés comme admin API (séparés par des virgules)
ALLOWED_ADMIN_IDS=

# Configuration de l'application
APP_NAME="Marché 241 API"
APP_VERSION="1.0.0"
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=https://marche241.ga

# Configuration CORS
CORS_ORIGIN=http://localhost:3000

# Configuration de sécurité
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuration du stockage objet (Cloudflare R2)
# Endpoint S3 du compte R2 (R2 > Manage R2 API Tokens)
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Identifiants du token R2 avec permission "Object Read & Write"
STORAGE_ACCESS_KEY_ID=your-r2-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Nom du bucket R2
STORAGE_BUCKET=marche241-uploads

# URL publique servant le bucket (domaine personnalisé ou sous-domaine r2.dev)
STORAGE_PUBLIC_URL=https://cdn.example.com

# Région : R2 l'ignore mais le SDK S3 l'exige (laisser "auto")
STORAGE_REGION=auto

# Variables d'environnement spécifiques à marche241
APP_NAME=Marche241 API
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Configuration de logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Configuration WhatsApp Business API (Meta Cloud API)
# Utilisé pour les templates transactionnels : confirmation, expédition, livraison, notif vendeur
# Mêmes credentials que l'admin (WhatsappConfig / campagnes Meta)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token-here
META_WHATSAPP_GRAPH_VERSION=v21.0

# Configuration GREEN-API (messages texte fallback, check-number, OTP)
GREEN_API_ID_INSTANCE=your-green-api-instance-id
GREEN_API_TOKEN=your-green-api-token
GREEN_API_URL=https://api.green-api.com

# Configuration Resend pour l'envoi d'emails transactionnels (API HTTP, pas de SMTP —
# Render restreint les connexions SMTP sortantes)
RESEND_API_KEY=your-resend-api-key-here
MAIL_FROM_ADDRESS="noreply@marche241.ga"
MAIL_FROM_NAME="Marché241"

# Webhook SMS uniquement (les OTP/emails vendeur envoyés par email passent désormais par Resend)
WEBHOOK_VERIFICATION_URL=https://exemple.webhook.com
WEBHOOK_SECRET=

# Réconciliation paiements Ebilling (cron externe) — défaut 60 min
PAYMENT_RECONCILE_AFTER_MINUTES=60

# Configuration Ebilling (Billing Easy)
EBILLING_API_ID=your-ebilling-api-id
EBILLING_API_SECRET=your-ebilling-api-secret
EBILLING_USER_NAME=your-ebilling-username
EBILLING_SHARED_KEY=your-ebilling-shared-key

# URLs Ebilling (Optionnel, valeurs de staging par défaut)
EBILLING_AUTH_URL=https://staging.billing-easy.net/shap/api/v1/merchant/auth
EBILLING_CREATE_INVOICE_URL=https://staging.billing-easy.net/shap/api/v1/merchant/create-invoice
EBILLING_SEND_USSD_PUSH_URL=https://staging.billing-easy.net/shap/api/v1/merchant/send-ussd-push
EBILLING_SERVER_URL=https://stg.billing-easy.com/api/v1/merchant/e_bills
EBILLING_CARD_REDIRECT_BASE=https://staging.billing-easy.net/
EBILLING_CARD_OPERATOR=ORABANK_NG

# Captcha Cloudflare
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=votre_cle_secrete_obtenue_sur_cloudflare

# Sécurité cron (obligatoire en prod) — passer ?key= ou header x-cron-key
CRON_SECRET_KEY=change-me-cron-secret

# Secret interne pour webhooks / workers (header x-internal-secret)
INTERNAL_API_SECRET=change-me-internal-secret
